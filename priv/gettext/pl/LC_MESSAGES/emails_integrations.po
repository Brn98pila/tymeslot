#: lib/tymeslot/emails/templates/calendars_removed.ex
#, elixir-autogen, elixir-format
msgid "%{count} calendar is no longer on your calendar server"
msgid_plural "%{count} calendars are no longer on your calendar server"
msgstr[0] "%{count} kalendarz zniknął z serwera kalendarza"
msgstr[1] "%{count} kalendarze zniknęły z serwera kalendarza"
msgstr[2] "%{count} kalendarzy zniknęło z serwera kalendarza"

#: lib/tymeslot/emails/templates/calendars_removed.ex
