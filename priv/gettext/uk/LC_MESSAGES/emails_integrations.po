msgstr[1] "%{count} календарі зникли з вашого сервера календаря"
msgstr[2] "%{count} календарів зникло з вашого сервера календаря"

#: lib/tymeslot/emails/templates/calendars_removed.ex
#, elixir-autogen, elixir-format
