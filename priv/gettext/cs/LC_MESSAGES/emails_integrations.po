#: lib/tymeslot/emails/templates/calendars_removed.ex
#, elixir-autogen, elixir-format
msgid "These calendars are no longer on your calendar server, so Tymeslot has stopped using them:"
msgstr "Tyto kalendáře už na vašem kalendářovém serveru nejsou, a proto je Tymeslot přestal používat:"

#: lib/tymeslot/emails/templates/calendars_removed.ex
#, elixir-autogen, elixir-format
msgid "Tymeslot checked %{integration} and the server no longer has the calendar listed above. This usually means it was deleted, or stopped being shared with you, on the server. Your other calendars on %{integration} are unaffected."
msgid_plural "Tymeslot checked %{integration} and the server no longer has the calendars listed above. This usually means they were deleted, or stopped being shared with you, on the server. Your other calendars on %{integration} are unaffected."
msgstr[0] "Tymeslot zkontroloval integraci %{integration} a výše uvedený kalendář už na serveru není. Obvykle to znamená, že byl na serveru smazán nebo s vámi přestal být sdílen. Ostatních kalendářů v integraci %{integration} se to netýká."
msgstr[1] "Tymeslot zkontroloval integraci %{integration} a výše uvedené kalendáře už na serveru nejsou. Obvykle to znamená, že byly na serveru smazány nebo s vámi přestaly být sdíleny. Ostatních kalendářů v integraci %{integration} se to netýká."
msgstr[2] "Tymeslot zkontroloval integraci %{integration} a výše uvedené kalendáře už na serveru nejsou. Obvykle to znamená, že byly na serveru smazány nebo s vámi přestaly být sdíleny. Ostatních kalendářů v integraci %{integration} se to netýká."

#: lib/tymeslot/emails/templates/calendars_removed.ex
#, elixir-autogen, elixir-format
msgid "You get this email once each time a calendar disappears. The notice in your calendar settings stays until you dismiss it."
msgstr "Když kalendář zmizí, dostanete o tom jen tento jeden e-mail. Upozornění v nastavení kalendáře zůstane zobrazené, dokud ho nezavřete."

#: lib/tymeslot/emails/templates/calendars_removed.ex
#, elixir-autogen, elixir-format
msgid "“%{calendar}” is no longer on your calendar server"
msgstr "Kalendář „%{calendar}“ už na vašem kalendářovém serveru není"

#: lib/tymeslot/emails/templates/calendars_removed.ex
#, elixir-autogen, elixir-format
